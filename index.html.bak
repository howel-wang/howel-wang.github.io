        scenes: ["乌兰哈达火山地质公园", "3 号 / 6 号 / 8 号火山", "乌兰察布之夜", "乌兰察布市区"],
        advice: ["26 日抵京后早点休息", "火山段风大，带外套和防晒", "夜游可机动，不要影响第二天早起"],
        weather: {
          place: "乌兰察布 / 乌兰哈达",
          temp: "约 21 / 6℃",
          risk: "昼夜温差大",
          summary: "5 月下旬白天多为春末体感，夜里和火山口风感明显偏冷。火山区域无遮挡，风比市区更强。",
          tips: ["带防风外套或薄冲锋衣", "下午防晒，傍晚加衣", "火山拍照注意扬尘和风沙"]
        },
        reviews: ["火山到市区还有一段路，晚餐建议放在乌兰察布市区，选择会更多。", "乌兰察布之夜适合当作轻量夜游，若火山耗时较久可以缩短停留。", "餐厅用点评搜索更稳，出发前重点看近期评价和营业时间。"]
      },
      {
