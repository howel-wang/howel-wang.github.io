        scenes: ["云冈石窟", "大同古城", "华严寺周边", "古城夜景"],
        advice: ["云冈石窟建议放在白天核心时段", "古城夜游量力而行", "第二天返京，晚上别睡太晚"],
        weather: {
          place: "大同",
          temp: "约 25 / 7℃",
