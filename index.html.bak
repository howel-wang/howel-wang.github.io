        image: "assets/day5-yungang.jpg",
        copy: "从大同返北京约 4 小时，途中可路过悬空寺。若想进景区，需要给停车、排队和游览留足时间；若返程压力大，可只作远观或直接返京。",
        scenes: ["悬空寺", "浑源简餐", "返京高速", "北京"],
        advice: ["这天不建议安排复杂餐厅", "悬空寺按体力和路况机动", "返京前留足休息，避免夜间疲劳驾驶"],
        weather: {
          place: "大同 / 北京返程",
          temp: "大同约 25 / 7℃ · 北京约 29 / 14℃",
          risk: "长途驾驶 + 午后升温",
          summary: "大同早晚偏凉，北京午后更热。返程日跨度大，穿衣按分层处理，比单纯看北京天气更稳。",
          tips: ["车上放薄外套，进石窟也用得上", "午后返京注意补水和防困", "出发前重点看大同、北京两地降雨和大风预警"]
        },
        reviews: ["悬空寺是否入内取决于当天人流和返京时间，别让它挤压安全驾驶。", "返程日午餐以顺路、省时为主，浑源或服务区都可以作为机动点。", "北京抵达时间若偏晚，晚餐就近解决即可。"]
      }
    ];

    const tabs = document.querySelectorAll(".tab");
    const dayImage = document.getElementById("dayImage");
    const dayBadge = document.getElementById("dayBadge");
    const dayTitle = document.getElementById("dayTitle");
    const dayMeta = document.getElementById("dayMeta");
    const dayCopy = document.getElementById("dayCopy");
    const scenes = document.getElementById("scenes");
    const advice = document.getElementById("advice");
    const dayShops = document.getElementById("dayShops");
    const reviews = document.getElementById("reviews");
    const allShops = document.getElementById("allShops");
    const filters = document.querySelectorAll(".filter");
    const isMobile = () => /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);

    function shopCard(shop) {
      return `
        <article class="shop" data-type="${shop.type}">
          <div class="shop-head">
            <h3>${shop.name}</h3>
            <a class="link" href="${shop.link}" data-app-link="${shop.appLink}" target="_blank" rel="noopener">${shop.linkType}</a>
          </div>
          <p>${shop.city} · ${shop.note}</p>
          <div class="tag-row">${shop.tags.map(tag => `<span class="tag">${tag}</span>`).join("")}</div>
        </article>
      `;
    }

    function renderDay(index) {
      const day = days[index];
      dayImage.style.backgroundImage = `url("${day.image}")`;
      dayBadge.textContent = day.badge;
      dayTitle.textContent = day.title;
      dayMeta.innerHTML = [
        `🚗 ${day.km}`,
        `🏨 ${day.stay}`,
        `📍 ${day.theme}`,
        `🌤 ${day.weather.place} ${day.weather.temp}`,
        `⚠ ${day.weather.risk}`
      ].map(item => `<span class="pill">${item}</span>`).join("");
      dayCopy.textContent = day.copy;
      scenes.innerHTML = day.scenes.map(item => `<li>${item}</li>`).join("");
      advice.innerHTML = day.advice.map(item => `<li>${item}</li>`).join("");
      dayShops.innerHTML = shops.filter(shop => shop.day === index).map(shopCard).join("");
      reviews.innerHTML = day.reviews.map(item => `<p class="review">${item}</p>`).join("");
      tabs.forEach(tab => tab.classList.toggle("active", Number(tab.dataset.day) === index));
    }

    function renderAllShops(type = "all") {
      const filtered = type === "all" ? shops : shops.filter(shop => shop.type === type);
      allShops.innerHTML = filtered.map(shopCard).join("");
    }

    tabs.forEach(tab => {
      tab.addEventListener("click", () => renderDay(Number(tab.dataset.day)));
    });

    filters.forEach(filter => {
      filter.addEventListener("click", () => {
        filters.forEach(item => item.classList.remove("active"));
        filter.classList.add("active");
        renderAllShops(filter.dataset.filter);
      });
    });

    document.addEventListener("click", (event) => {
      const link = event.target.closest("a[data-app-link]");
      if (!link || !isMobile()) return;

      event.preventDefault();
      const fallbackUrl = link.href;
      const openedAt = Date.now();
      window.location.href = link.dataset.appLink;

      window.setTimeout(() => {
        if (Date.now() - openedAt < 1600 && document.visibilityState === "visible") {
          window.location.href = fallbackUrl;
        }
      }, 1200);
    });

    renderDay(0);
    renderAllShops();
  </script>
</body>
</html>
