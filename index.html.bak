        scenes: ["黄花沟草原", "辉腾草原", "草原日落", "草原民宿"],
        advice: ["黄花沟游玩时间较长，午餐尽量就近解决", "草原天气变化快，备雨具和外套", "日落前 40 分钟到观景点更从容"],
        weather: {
          place: "黄花沟 / 辉腾草原",
          temp: "约 20 / 5℃",
          risk: "风大 + 早晚偏冷",
          summary: "草原和开阔路段容易有大风，傍晚看日落时体感会比温度数字更冷。",
          tips: ["短袖外加薄外套最灵活", "草原段备帽子和墨镜", "遇大风时减少无人机和长时间户外停留"]
        },
        reviews: ["草原民宿晚餐和早餐建议提前问清楚，确认是否需要预订。", "黄花沟景区内外餐饮位置容易混淆，点链接后先看地图距离。", "当天不要再额外加远距离城市餐厅，夜间草原路段少开车更稳。"]
      },
      {
        badge: "Day 3 · 5月29日",
        title: "辉腾草原 → 呼和浩特",
        km: "约 1.5h",
        stay: "住呼和浩特市区",
        theme: "大昭寺 / 塞上老街",
        image: "assets/day2-grassland.jpg",
        copy: "从草原出发到呼和浩特约 1.5 小时。这天车程轻，适合把节奏放慢，下午游大昭寺、塞上老街等老城区域，晚上住呼和浩特市区。",
        scenes: ["大昭寺", "塞上老街", "呼和浩特老城", "市区晚餐"],
        advice: ["上午从民宿退房后再进城", "大昭寺和塞上老街可步行串联", "住宿选老城或交通方便区域"],
        weather: {
          place: "呼和浩特",
          temp: "约 25 / 10℃",
          risk: "日晒强 + 早晚温差",
          summary: "呼和浩特 5 月下旬白天适合步行游览，早晚仍会转凉。老城游玩以户外步行为主，注意防晒和补水。",
          tips: ["准备防晒和足量饮水", "傍晚加一件薄外套", "寺庙和街区按开放时间安排"]
        },
        reviews: ["呼和浩特餐饮选择多，建议围绕住宿点筛选，不必为单店穿城。", "大昭寺和塞上老街适合连在一起玩，晚饭可安排在老城附近。", "如果前一天草原休息一般，这天可以少排室内外切换，留出补觉时间。"]
      },
      {
        badge: "Day 4 · 5月30日",
        title: "呼和浩特 → 大同",
